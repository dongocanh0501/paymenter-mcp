{
  "name": "paymenter_update_service",
  "description": "Update attributes, pricing, or expiration of an existing service.",
  "parameters": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "service_id": {
        "type": "integer",
        "description": "Numeric ID of the service to update."
      },
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "active",
          "suspended",
          "cancelled"
        ],
        "description": "Updated service status."
      },
      "expires_at": {
        "type": "string",
        "description": "Updated expiration ISO 8601 timestamp."
      },
      "suspend_hold_until": {
        "type": "string",
        "description": "Updated grace period ISO 8601 timestamp."
      },
      "price": {
        "type": "number",
        "description": "Updated price amount."
      },
      "currency_code": {
        "type": "string",
        "description": "Updated 3-letter ISO currency code."
      },
      "quantity": {
        "type": "integer",
        "minimum": 1,
        "description": "Updated service quantity."
      },
      "plan_id": {
        "type": "integer",
        "description": "Updated plan ID."
      },
      "product_id": {
        "type": "integer",
        "description": "Updated product ID."
      },
      "order_id": {
        "type": "integer",
        "description": "Updated linked order ID."
      },
      "subscription_id": {
        "type": "string",
        "description": "Updated gateway subscription token."
      },
      "coupon_id": {
        "type": "integer",
        "description": "Updated coupon ID."
      }
    },
    "required": [
      "service_id"
    ],
    "additionalProperties": false
  }
}