{
  "name": "paymenter_create_order",
  "description": "Create a new order record for a specific customer.",
  "parameters": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "user_id": {
        "type": "integer",
        "description": "Customer ID who owns the order."
      },
      "currency_code": {
        "type": "string",
        "description": "3-letter ISO currency code (e.g. 'USD', 'EUR')."
      }
    },
    "required": [
      "user_id",
      "currency_code"
    ],
    "additionalProperties": false
  }
}