{
  "name": "paymenter_create_service",
  "description": "Directly provision or create a service instance for a customer.",
  "parameters": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "user_id": {
        "type": "integer",
        "description": "Customer ID receiving the service."
      },
      "product_id": {
        "type": "integer",
        "description": "Product ID to provision."
      },
      "plan_id": {
        "type": "integer",
        "description": "Billing plan ID (e.g. monthly, annual cycle)."
      },
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "active",
          "suspended",
          "cancelled"
        ],
        "description": "Initial service status."
      },
      "currency_code": {
        "type": "string",
        "description": "3-letter ISO currency code (e.g. 'USD')."
      },
      "price": {
        "type": "number",
        "description": "Recurring or base price (e.g. 25.00)."
      },
      "quantity": {
        "type": "integer",
        "minimum": 1,
        "default": 1,
        "description": "Service quantity. Defaults to 1."
      },
      "expires_at": {
        "type": "string",
        "description": "ISO 8601 expiration timestamp (e.g. '2026-11-06T00:00:00Z')."
      },
      "order_id": {
        "type": "integer",
        "description": "Linked order ID, if applicable."
      },
      "coupon_id": {
        "type": "integer",
        "description": "Discount coupon ID applied."
      },
      "subscription_id": {
        "type": "string",
        "description": "External payment gateway subscription token."
      },
      "suspend_hold_until": {
        "type": "string",
        "description": "Grace period ISO 8601 timestamp before suspension."
      }
    },
    "required": [
      "user_id",
      "product_id",
      "plan_id",
      "status",
      "currency_code",
      "price",
      "quantity"
    ],
    "additionalProperties": false
  }
}